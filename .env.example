# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase Postgres connection string (Settings -> Database -> Connection string,
# "Transaction pooling" mode). Keep the password secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Kite Connect app credentials (https://developers.kite.trade/apps) — needed only
# for the live tick streamer (ingestion/kite_ticks.py + kite_login.py).
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Filled in daily by running: python ingestion/kite_login.py
KITE_ACCESS_TOKEN=
